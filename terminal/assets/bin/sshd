#!/bin/sh
set -u

root=${C1_APPS_ROOT:-/storage/apps/current}
data=${C1_APPS_DATA:-/storage/apps/data}/terminal/dropbear
auth=${C1_SSH_AUTH_DIR:-/storage/terminal/dropbear}
auth_parent=${auth%/*}
server="$root/linux-tools/bin/dropbear"
keygen="$root/linux-tools/bin/dropbearkey"
key="$data/dropbear_ed25519_host_key"
authorized="$auth/authorized_keys"
pidfile="$data/dropbear.pid"
port=${C1_SSH_PORT:-2222}

usage() {
    echo "usage: sshd start|stop|status" >&2
    exit 2
}

running() {
    [ -s "$pidfile" ] || return 1
    pid=$(cat "$pidfile" 2>/dev/null || true)
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    kill -0 "$pid" 2>/dev/null
}

case "${1:-}" in
    start)
        if running; then
            echo "sshd already running ($(cat "$pidfile"))"
            exit 0
        fi
        mkdir -p "$data" || exit 1
        chmod 700 "$data"
        mkdir -p "$auth" || exit 1
        chmod 700 "$auth_parent"
        chmod 700 "$auth"
        if [ ! -f "$authorized" ]; then
            : > "$authorized" || exit 1
        fi
        chmod 600 "$authorized"
        if [ ! -s "$key" ]; then
            "$keygen" -t ed25519 -f "$key" || exit 1
            chmod 600 "$key"
        fi
        rm -f "$pidfile"
        "$server" -D "$auth" -r "$key" -p "$port" -P "$pidfile"
        sleep 1
        if running; then
            echo "sshd started on port $port (pid $(cat "$pidfile"))"
            exit 0
        fi
        echo "sshd failed to start" >&2
        exit 1
        ;;
    stop)
        if running; then
            kill "$(cat "$pidfile")" 2>/dev/null || true
            i=0
            while running && [ "$i" -lt 20 ]; do sleep .1; i=$((i + 1)); done
        fi
        rm -f "$pidfile"
        echo "sshd stopped"
        ;;
    status)
        if running; then
            echo "sshd running on port $port (pid $(cat "$pidfile"))"
        else
            echo "sshd stopped"
            exit 1
        fi
        ;;
    *) usage ;;
esac

+static int c1max_load_password_hash(void) {
+	FILE *file;
+	char hash[256];
+	char *end;
+
+	struct stat st; int fd;
+	if (ses.authstate.pw_uid != 0) return 0;
+	fd = open(C1MAX_PASSWORD_HASH_FILE, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+	if (fd < 0) return 0;
+	if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_uid != 0 || (st.st_mode & 077)) { close(fd); return 0; }
+	file = fdopen(fd, "r");
+	if (!file) { close(fd); return 0; }
+	if (!fgets(hash, sizeof(hash), file)) {
+		fclose(file);
+		return 0;
+	}
+	fclose(file);
+	end = hash;
+	while (*end && *end != '\n' && *end != '\r') end++;
+	*end = '\0';
+	if (hash[0] != '$' || (hash[1] != '5' && hash[1] != '6') || hash[2] != '$') return 0;
+	m_free(ses.authstate.pw_passwd);
+	ses.authstate.pw_passwd = m_strdup(hash);
+	return 1;
+}
+
+/* C1Max has no target libcrypt in the cross toolchain. Verify the stored
+ * SHA-crypt value through the small read-only-system helper instead. */
+static char c1max_crypt_output[256];
+static char *c1max_crypt(const char *password, const char *stored) {
+	int input[2], output[2];
+	pid_t pid;
+	const char *method;
+	const char *salt_start;
+	const char *salt_end;
+	char salt[32];
+	size_t salt_len;
+	size_t sent = 0;
+	ssize_t count;
+	int status = 0; pid_t waited;
+
+	if (stored[0] != '$' || (stored[1] != '5' && stored[1] != '6') || stored[2] != '$') return NULL;
+	method = stored[1] == '6' ? "sha512" : "sha256";
+	salt_start = stored + 3;
+	salt_end = strchr(salt_start, '$');
+	if (!salt_end || salt_end == salt_start || (size_t)(salt_end - salt_start) >= sizeof(salt)) return NULL;
+	salt_len = (size_t)(salt_end - salt_start);
+	memcpy(salt, salt_start, salt_len);
+	salt[salt_len] = '\0';
+	if (pipe(input) != 0) return NULL;
+	if (pipe(output) != 0) { close(input[0]); close(input[1]); return NULL; }
+	pid = fork();
+	if (pid < 0) {
+		close(input[0]); close(input[1]); close(output[0]); close(output[1]);
+		return NULL;
+	}
+	if (pid == 0) {
+		dup2(input[0], STDIN_FILENO);
+		dup2(output[1], STDOUT_FILENO);
+		close(input[0]); close(input[1]); close(output[0]); close(output[1]);
+		execl("/usr/bin/cryptpw", "cryptpw", "-P", "0", "-m", method, "-S", salt, (char *)NULL);
+		_exit(127);
+	}
+	close(input[0]);
+	close(output[1]);
+	while (password[sent]) {
+		count = write(input[1], password + sent, strlen(password) - sent);
+		if (count < 0 && errno == EINTR) continue;
+		if (count <= 0) break;
+		sent += (size_t)count;
+	}
+	close(input[1]);
+	do { count = read(output[0], c1max_crypt_output, sizeof(c1max_crypt_output) - 1); } while (count < 0 && errno == EINTR);
+	close(output[0]);
+	do { waited = waitpid(pid, &status, 0); } while (waited < 0 && errno == EINTR);
+	if (waited != pid || sent != strlen(password) || count <= 0 || !WIFEXITED(status) || WEXITSTATUS(status) != 0) return NULL;
+	c1max_crypt_output[count] = '\0';
+	while (count > 0 && (c1max_crypt_output[count - 1] == '\n' || c1max_crypt_output[count - 1] == '\r')) c1max_crypt_output[--count] = '\0';
+	return c1max_crypt_output;
+}

set(ENABLE_SHARED OFF CACHE BOOL "" FORCE)
set(ENABLE_STATIC ON CACHE BOOL "" FORCE)
set(BUILD_TOXAV OFF CACHE BOOL "" FORCE)
set(UNITTEST OFF CACHE BOOL "" FORCE)
set(AUTOTEST OFF CACHE BOOL "" FORCE)
set(DHT_BOOTSTRAP OFF CACHE BOOL "" FORCE)
set(BOOTSTRAP_DAEMON OFF CACHE BOOL "" FORCE)
set(MIN_LOGGER_LEVEL ERROR CACHE STRING "" FORCE)
if(CMAKE_CROSSCOMPILING)
  set(C1_SODIUM_ARCH mipsel-linux-gnu)
else()
  set(C1_SODIUM_ARCH ${CMAKE_LIBRARY_ARCHITECTURE})
endif()
set(C1_SODIUM "/usr/lib/${C1_SODIUM_ARCH}/libsodium.a")
if(NOT EXISTS "${C1_SODIUM}")
  message(FATAL_ERROR "Missing ${C1_SODIUM}; use tools/build.sh's Docker builder")
endif()
add_library(libsodium::libsodium STATIC IMPORTED GLOBAL)
set_target_properties(libsodium::libsodium PROPERTIES IMPORTED_LOCATION "${C1_SODIUM}" INTERFACE_INCLUDE_DIRECTORIES /usr/include)
add_subdirectory(${C1_TOX_ROOT}/.deps/c-toxcore ${CMAKE_BINARY_DIR}/toxcore EXCLUDE_FROM_ALL)
